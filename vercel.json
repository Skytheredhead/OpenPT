{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo 'Skipping install for static OpenPT deploy'",
  "buildCommand": "node scripts/build-static.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/home.html",
      "destination": "/home.html"
    },
    {
      "source": "/wordle",
      "destination": "/wordle.html"
    },
    {
      "source": "/wordle/",
      "destination": "/wordle.html"
    },
    {
      "source": "/jeopardy",
      "destination": "/jeopardy.html"
    },
    {
      "source": "/jeopardy/",
      "destination": "/jeopardy.html"
    },
    {
      "source": "/games",
      "destination": "/games.html"
    },
    {
      "source": "/games/",
      "destination": "/games.html"
    },
    {
      "source": "/firewall",
      "destination": "/firewall.html"
    },
    {
      "source": "/firewall/",
      "destination": "/firewall.html"
    },
    {
      "source": "/bomb",
      "destination": "/bomb.html"
    },
    {
      "source": "/bomb/",
      "destination": "/bomb.html"
    },
    {
      "source": "/ccnacasino",
      "destination": "/ccnacasino.html"
    },
    {
      "source": "/ccnacasino/",
      "destination": "/ccnacasino.html"
    },
    {
      "source": "/jeopardy-theme.m4a",
      "destination": "/01%20Jeopardy%20%28Main%20Theme%29.m4a"
    },
    {
      "source": "/jeopardy-sfx/:file",
      "destination": "/public/audio/jeopardy-sfx/:file"
    },
    {
      "source": "/lab",
      "destination": "/index.html"
    },
    {
      "source": "/lab/",
      "destination": "/index.html"
    },
    {
      "source": "/quiz/ccna-b-diagrams",
      "destination": "/quiz/index.html"
    },
    {
      "source": "/quiz/ccna-b-diagrams/",
      "destination": "/quiz/index.html"
    },
    {
      "source": "/share/:token",
      "destination": "/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
